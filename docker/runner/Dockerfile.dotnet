FROM ai-factory/runner-base:latest
USER root
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet \
    && /tmp/dotnet-install.sh --channel 9.0 --install-dir /usr/share/dotnet \
    && ln -s /usr/share/dotnet/dotnet /usr/local/bin/dotnet && rm /tmp/dotnet-install.sh
USER agent
RUN dotnet tool install --global dotnet-format || true
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 PATH=/home/agent/.dotnet/tools:$PATH FACTORY_IMAGE=dotnet
